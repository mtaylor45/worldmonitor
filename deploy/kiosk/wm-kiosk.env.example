# Copy to /etc/default/wm-kiosk and edit. Read by wm-kiosk.service.

# Where the dashboard is served. LAN only — no cloud APIs in the runtime path.
WM_KIOSK_URL=http://localhost:5173/

# Theme to pin at boot. One of: default, lcars, lcars-bright.
# `lcars` is the Drexler palette, `lcars-bright` the higher-contrast variant;
# which one is legible at 2.5 m on the 163-PPI panel is a hardware test
# (SCOPE.md §7.1), so this is expected to change once the panel exists.
WM_KIOSK_THEME=lcars

WM_KIOSK_PROFILE=/var/lib/wm-kiosk/chromium
WM_KIOSK_BROWSER=/usr/bin/chromium

# ---- Two-display profile (wm-kiosk-dual.service) -------------------------
#
# Only read by the dual unit. The single-display profile ignores all of it.
#
# OUTPUT NAMES ARE MACHINE-SPECIFIC and there is no sensible default: guessing
# would put the console on the dashboard panel. Find them with
#
#     swaymsg -t get_outputs | grep -E '"name"|"model"'
#
# The unit refuses to start until both are set, rather than coming up with the
# displays swapped — which on a wall panel reads as a broken install.
WM_KIOSK_OUT_DASHBOARD=
WM_KIOSK_OUT_NAV=

# Touchscreen identifiers, from `swaymsg -t get_inputs`. A touchscreen left
# unmapped sends coordinates in the whole-layout space, so a touch on the lower
# panel lands on the upper one. Leave empty on a single-touchscreen setup; the
# mapping lines are dropped and a warning is logged.
WM_KIOSK_TOUCH_DASHBOARD=
WM_KIOSK_TOUCH_NAV=
